<%= form_with(url: elearning_exams_path, builder: BootstrapBuilder) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :title, "Título"%>
    <%= form.text_field :title, class: "form-control-sm" %>
    <%= inline_error_for(:title, exam, "offset-3") %>
  </div>
  <div class="mt-2">
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
