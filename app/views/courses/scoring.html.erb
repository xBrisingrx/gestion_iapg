<h1>Registrar notas a curso</h1>
<div class="row justify-content-between mb-2" data-controller="forms--register-scoring">
  <section>
    <div class="row mb-4">
      <div class="col-2">Tipo de curso:</div>
      <div class="col-4">
        <select name="" id="" data-controller="tselect" data-forms--register-scoring-target="typeCourse" data-action="change->forms--register-scoring#get_courses">
          <option value="">Seleccione curso</option>
          <% @course_types.each do |course_type| %>
            <option value="<%= course_type.id %>"><%= course_type.name %></option>
          <% end %>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="col-2">Cursos:</div>
      <div class="col-4">
        <%= turbo_frame_tag "courses", 
          data: { forms__register_scoring_target: "selectCourses" } do %>
          <select name="" id="">
            <option value="">Cursos</option>
          </select>
        <% end %>
      </div>
    </div>
  </section>
  <section>
    <%= turbo_frame_tag "course_people", 
          data: { forms__register_scoring_target: "tableCoursePeople" } %>  
  </section>
</div>