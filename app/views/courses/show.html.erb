<%= render "shared/modal2", title: @course.course_type.name, fade_in: true do %>
  <section class="mb-2">
    <div class="row mb-2">
      <div class="col-4"><b>Fecha:</b> <%= date_format(@course.from_date) %></div>
      <div class="col-4"><b>Tipo de curso:</b> <%= @course.course_type.name %></div>
      <div class="col-4"><b>Codigo:</b> <%= @course.code %></div>
    </div>
    <div class="row mb-2">
      <% if current_user.admin? %>
        <div class="col-4"><b>Nro anual:</b> <%= @course.year_number %></div>
        <div class="col-4"><b>Nro general:</b> <%= @course.general_number %></div>
      <% end %>
      <div class="col-4"><b>Sala:</b> <%= @course.room.name %></div>
    </div>
    <% if current_user.admin? %>
      <div class="row mb-2">
        <div class="col-6"><b>¿Es In Company?</b> <%= (@course.is_company) ? "Si" : "No" %> </div>
        <div class="col-6"><%= (@course.is_company) ? "<b>Razon social: #{@course.company&.name}</b>".html_safe : "" %></div>
      </div>
    <% end %>
  </section>
  <%= turbo_frame_tag "course_people", src:  course_course_people_path(@course) %>
<% end %>