<%= render "shared/modal2", title: "Registro de notas", fade_in: true do %>
  <%= form_with(model: @course, builder: BootstrapBuilder)  do |form| %>
    <p><b>Nombre y apellido:</b> <%= @person.fullname %> </p>
    <p><b>Empresa:</b> <%= @course_person.first.company.name %> </p>
    <p><b>Tipo de cupo:</b> -- </p>
    <% @course_person.each_with_index do |c_p, index| %>
      <input type="hidden" 
          name="course[course_people_attributes][<%= index %>][id]" 
          id="course_course_people_attributes_<%= index %>_id"
          value=<%= c_p.id %> >
      <% if c_p.unit.category == "Teórico" %>
        <%= render partial: "courses/input_teorico", locals: { course_person: c_p, index: index } %>
      <% end %>
      <% if c_p.unit.category == "Práctico" %>
        <%= render partial: "courses/input_practico", locals: { course_person: c_p, index: index } %>
      <% end %>
      <% if c_p.unit.category == "Psicométrico" %>
        <%= render partial: "courses/input_psicometrico", locals: { course_person: c_p, index: index } %>
      <% end %>
    <% end %>
    <div class='mt-2'>
    <%= form.submit 'Guardar' %>
      <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
    </div>
  <% end %>
<% end %>

