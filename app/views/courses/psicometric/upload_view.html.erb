<h1>Psicometricos</h1>
<h3>Archivo PDF con el psicometrico de la persona</h3>
<p>En nombre del archivo tiene que ser el CUIL de la persona. Ej: 00999999990.pdf</p>
<p>Solo se puede cargar PDF.</p>
<hr>
<%= form_with url: upload_files_courses_psicometric_index_path, local: true, multipart: true, builder: BootstrapBuilder do |f| %>
  <%= f.file_field :zip_file %>
  <%= f.submit %>
<% end %>