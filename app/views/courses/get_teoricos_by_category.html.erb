<%= turbo_frame_tag "courses", data: {forms__register_to_course_target: "selectTeorico"} do %>
  <div class="form-group row">
    <div class="col-3">
      <label for="">Curso teorico: </label>
    </div>
    <div class="col-8">
      <select name="course[teorico_id]" id="course_teorico_id"
        data-controller="tselect"
        data-forms--register-to-course-target="courseTeorico"
        data-action="change->forms--register-to-course#select_practicos" >
        <option value="">Seleccione teoria</option>
        <% @courses.each do |course| %>
          <option 
            value="<%= course.course_unit_id %>"
            data-date="<%= course.from_date %>"
            data-course="<%= course.id %>"
            data-unit="<%= course.unit_id %>"> 
            <%= "#{date_format(course.from_date)} #{course.unit_name} sala: #{course.room_name}"  %>
          </option>
        <% end %>
      </select>
    </div>
  </div>
<% end %>