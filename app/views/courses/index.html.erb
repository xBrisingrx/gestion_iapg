<h1>Cursos</h1>
<div class="row">
  <div class="col-2">
    <% if policy(@courses).new? %>
      <%= link_to "Registrar curso", 
        new_course_path,
        class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
  <div class="col-2">
    <%= link_to "Registrar cupo", 
      new_courses_registration_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-info" %>
  </div>
  <div class="col-2">
    <%= link_to "Solo teoria", 
      new_courses_theoric_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-warning" %>
  </div>

  <div class="col-2">
    <%= link_to "Solo practica", 
      new_courses_practice_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-info" %>
  </div>

  <div class="col-2">
    <%= link_to "Solo psicometrico", 
      new_courses_psicometric_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-secondary" %>
  </div>

  <div class="col-2">
    <%= link_to "In Company", 
      new_courses_in_company_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-danger" %>
  </div>

  <div class="col-2">
    <%= link_to "Particular", 
      modal_particular_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-info" %>
  </div>
</div>

<section class="mx-2">
  <%= turbo_frame_tag "calendar", src: calendar_admin_path %>
</section>