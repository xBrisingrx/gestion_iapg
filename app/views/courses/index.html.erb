<h1>Cursos</h1>
<div class="row">
  <div class="col-2">
    <% if policy(@courses).new? %>
      <%= link_to "Registrar curso", 
        new_course_path,
        class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
  <div class="col-2">
    <%= link_to "Registrar cupo", 
      new_courses_registration_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-info" %>
  </div>
  <div class="col-2">
    <%= link_to "Solo teoria", 
      new_courses_theoric_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-warning" %>
  </div>

  <div class="col-2">
    <%= link_to "Solo psicometrico", 
      new_courses_psicometric_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-secondary" %>
  </div>

  <div class="col-2">
    <%= link_to "In Company", 
      new_courses_in_company_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-danger" %>
  </div>
</div>

<section class="mx-2">
  <%= turbo_frame_tag "calendar", src: calendar_month_path %>
</section>

<div class="row justify-content-between mb-2 mt-4 d-none">
  <div class="col-6">
    <%= search_form_for @query, method: :get, data: { controller: "filter", filter_target: "form", turbo_frame: "table" } do |form| %>
      <%= form.search_field :room_name_cont,
          placeholder: "Filtrar...",
          class: "form-control form-control-sm",
          autocomplete: "off",
          data: { action: "input->filter#search" }
        %>
    <% end %>
  </div>
</div>
<hr>
<%= turbo_frame_tag 'table', id: 'courses_table', class: "mt-4" do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th><%= sort_link(@query, :date, "Fecha") %></th>
          <th><%= sort_link(@query, :course_type, "Curso") %></th>
          <th><%= sort_link(@query, :room, "Sala") %></th>
          <th><%= sort_link(@query, :company, "Empresa") %></th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_courses'>
        <%= render @courses %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 5}) if @courses.empty?%>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>