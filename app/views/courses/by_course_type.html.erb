<%= turbo_frame_tag "courses" do %>
  <select name="" id="select_courses" 
    data-controller="tselect"
    data-forms--register-scoring-target="selectCourses"
    data-action="change->forms--register-scoring#draw_course_people_table">
    <option value="">Seleccione curso</option>
    <% @courses.each do |course| %>
      <option value="<%= course.id %>"><%= "#{date_format(course.from_date)} Sala: #{course.room.name} Sede: #{course.room.headquarter.name}" %></option>
    <% end %>
  </select>
<% end %>