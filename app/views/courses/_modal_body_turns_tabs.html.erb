<%= turbo_frame_tag "turns" do %>
<!-- Nav -->
    <div class="text-center">
      <ul class="nav nav-segment nav-pills mb-7" role="tablist">
        <% @units.each do |unit| %>
          <li class="nav-item">
            <a class="nav-link <%= (@tab_active == unit[1]) ? 'active' : '' %>" 
                id="nav-<%= unit[0] %>-tab" 
                href="#nav-<%= unit[0] %>" 
                data-bs-toggle="pill" 
                data-bs-target="#nav-<%= unit[0] %>" 
                role="tab" aria-controls="nav-<%= unit[0] %>" 
                aria-selected="true"><%= unit[1] %>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
    <!-- End Nav -->

          <!-- Tab Content -->
          <div class="tab-content">
            <% @units.each do |unit| %>
              <div class="tab-pane fade show" id="nav-<%= unit[0] %>" role="tabpanel" aria-labelledby="nav-<%= unit[0] %>-tab">
                <div class="row justify-content-between">
                  <% tab_course_units = @course_units.where(unit_id: unit[0]) %>
                  <% tab_course_units.first.lists.times do |list| %>
                      <div class="col-6">
                          <h4>Lista <%= list+1 %></h4>
                          <table class="table">
                            <thead>
                              <th> Hora </th>
                              <th> Persona </th>
                              <th>Estado</th>
                            </thead>
                            
                              <%= turbo_frame_tag "turns_body" do %>
                              <tbody>
                                <% @course_units.where(unit_id: unit[0], list: list+1).each do |course_unit| %>
                                  <% course_unit.turns.each do |turn| %>
                                    <tr>
                                      <td><%= hour_format(turn.hour) %></td>
                                      <td><%= turn.person&.fullname %></td>
                                      <td>
                                        <% if !turn.busy? %>
                                          <%= form_with(model: [course_unit.course,turn], data: {controller: "forms--turn", "forms--turn-target": "form"}) do |form| %>
                                            <%= form.select :status, 
                                              { available: 'Disponible', reserved: 'Reservado'  }.map { |status| [status[1], status[0]] },
                                              { include_blank: false }, 
                                              class: "form-select form-select-sm",
                                              data: {
                                                action: "forms--turn#update_turn",
                                              } %>
                                          <% end %>
                                            <% else %>
                                            <%= form_with(url: course_change_turn_path(course_id: course_unit.course.id, 
                                                  turn_id: turn.id, 
                                                  course_unit_id: course_unit.id,
                                                  list: list), data: {controller: "forms--turn", "forms--turn-target": "changeTurn"}) do |form| %>
                                              <%= form.select :change_turn_id, 
                                                @available_turns.map { |turn| [hour_format(turn.hour), turn.id] },
                                                { include_blank: true, placeholder: "cambiar hora" },
                                                class: "form-select form-select-sm",
                                                data: {
                                                  controller: "tselect",
                                                  action: "forms--turn#change_turn",
                                                } %>
                                            <% end %>
                                        <% end %>
                                      </td>
                                    </tr>
                                  <% end %>
                                <% end %>
                            </tbody>

                              <% end %>
                          </table>
                        </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <!-- End Tab Content -->
<% end %>