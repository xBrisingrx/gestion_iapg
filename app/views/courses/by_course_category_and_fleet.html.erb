<%= turbo_frame_tag "courses", data: {forms__register_to_course_target: "selectTeorico"} do %>
  <div class="form-group row">
    <div class="col-4">
      <label for="">Seleccione curso teorico: </label>
    </div>
    <div class="col-4">
      <select name="course[teorico_id]" id="course_teorico_id"
        data-controller="tselect"
        data-forms--register-to-course-target="courseTeorico"
        data-action="change->forms--register-to-course#select_practicos" >
        <option value="">Seleccione teoria</option>
        <% @courses.each do |course| %>
          <% if (course.course.course_type.category.downcase == @course_category) && ( course.course.course_type.fleet == @fleet || course.course.course_type.fleet == "both" )  %>
            <option 
              value="<%= course.id %>"
              data-date="<%= course.course.from_date %>"> 
              <%= "#{date_format(course.course.from_date)} #{course.unit.name} sala: #{course.course.room.name}"  %>
            </option>
          <% end %>
        <% end %>
      </select>
    </div>
  </div>
<% end %>