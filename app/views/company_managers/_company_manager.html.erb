<div id="<%= dom_id company_manager %>">
  <p>
    <strong>Company:</strong>
    <%= company_manager.company_id %>
  </p>

  <p>
    <strong>Person:</strong>
    <%= company_manager.person_id %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= company_manager.email %>
  </p>

  <p>
    <strong>Job:</strong>
    <%= company_manager.job %>
  </p>

  <p>
    <strong>Notifications:</strong>
    <%= company_manager.notifications %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= company_manager.active %>
  </p>

</div>
