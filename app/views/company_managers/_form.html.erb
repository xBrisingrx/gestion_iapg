<%= form_with(model: company_manager) do |form| %>
  <% if company_manager.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(company_manager.errors.count, "error") %> prohibited this company_manager from being saved:</h2>

      <ul>
        <% company_manager.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
