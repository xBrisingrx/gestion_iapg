<h1>Categorías de empresas</h1>
<div class="row justify-content-between mb-2">
  <div class="col-4">
    <% if policy(@company_categories).new? %>
      <%= link_to "Registrar categoría", 
        new_company_category_path,
        data: { turbo_frame: "modal"},
        class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
  <%= render "shared/filter_form", url_path: company_categories_path %>
</div>
<%= turbo_frame_tag 'table', id: 'company_categories_table' do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Nombre</th>
          <th>Cupos</th>
          <th>Descripción</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_company_categories'>
        <%= render @company_categories %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 4}) if @company_categories.empty?%>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
