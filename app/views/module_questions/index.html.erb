<%= render "shared/modal", title: "Preguntas asignadas", fade_in: true do %>
  <%= turbo_frame_tag "form" do %>
    <%= render(partial: "module_questions/form", 
               locals: {
                module_question: ModuleQuestion.new,
                exam_module_id: @exam_module.id,
                questions: @questions
              }) %>
  <% end %>
  <%= turbo_frame_tag "table", id: "module_questions_table" do %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="thead-light">
          <tr>
            <th>#</th>
            <th>Pregunta</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="tbody_module_questions">
          <%= render @module_questions %>
          <%= render(partial: "shared/not_found_data", locals: {colspan: 3}) if @module_questions.empty?%>
        </tbody>
      </table>
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %> 
<% end %>