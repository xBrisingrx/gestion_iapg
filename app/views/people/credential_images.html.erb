<h1>Credenciales</h1>
<h3>Imagenes para personas</h3>

<%= render("form_images") %>

<hr>
<div class="col-6 col-md-4 col-lg-3">
    <%= form_with url: imagenes_credenciales_people_path, method: :get, data: { controller: "filter", filter_target: "form", turbo_frame: "table" } do |form| %>
      <div class="input-group input-group-sm">
        <span class="input-group-text">
          <i class="bi bi-search"></i>
        </span>
        <%= form.search_field :name,
          placeholder: "Filtrar...",
          class: "form-control form-control-sm",
          autocomplete: "off",
          data: { action: "input->filter#search" }
        %>
      </div>
    <% end %>
  </div>
</div>
<%= turbo_frame_tag 'table', id: 'people_table' do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Imagen</th>
          <th>Apellido</th>
          <th>Nombre</th>
          <th>CUIL</th>
          <th>Email</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_people'>
        <%= render("people/credentials_table", people: @people) %>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>