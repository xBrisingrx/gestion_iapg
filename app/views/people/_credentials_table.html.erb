<% people.each do |person| %>
  <%= tag.tr id: dom_id(person) do %>
    <td>
      <% if person.images.last&.representable? %>
        <%= image_tag person.images.last.representation(resize_to_limit: [100, 100]) %>
      <% end %>
    </td>
    <td><%= person.cuil %></td>
    <td><%= person.last_name %></td>
    <td><%= person.name %></td>
    <td>fecha</td>
    <td>credencial</td>
  <% end %>
<% end %>