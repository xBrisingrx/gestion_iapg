<%= form_with(model: person, builder: BootstrapBuilder, data: { controller: "forms--person" }) do |form| %>
  <% if person.images.last&.representable? %>
    <%= image_tag person.images.last.representation(resize_to_limit: [100, 100]) %>
  <% end %>

  <div class="form-group row mb-2">
    <%= form.label :cuil %>
    <%= form.text_field :cuil, 
      data: { 
        forms__person_target: "cuil",
        action: "change->forms--person#check_cuil" },
      required: true %>
    <%= inline_error_for(:cuil, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :last_name, "Apellido" %>
    <%= form.text_field :last_name, required: true %>
    <%= inline_error_for(:last_name, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name, required: true %>
    <%= inline_error_for(:name, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :birthdate, "Fecha nacimiento" %>
    <%= form.date_field :birthdate, required: true %>
    <%= inline_error_for(:birthdate, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :phone, "Teléfono" %>
    <%= form.text_field :phone, required: true %>
    <%= inline_error_for(:phone, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :celphone, "Celular" %>
    <%= form.text_field :celphone, required: true %>
    <%= inline_error_for(:celphone, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :email %>
    <%= form.email_field :email, required: true %>
    <%= inline_error_for(:email, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :direction, "Dirección" %>
    <%= form.text_field :direction, required: true %>
    <%= inline_error_for(:direction, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :code, "Código" %>
    <%= form.text_field :code %>
    <%= inline_error_for(:code, person, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :city_id, "Ciudad" %>
    <div class="col-6">
      <%= form.select :city_id, City.all.includes(:province).collect { |city| [ "#{city.province.name} #{city.name}", city.id ] },
        {:include_blank => "Seleccione ciudad"},
        data: { controller: 'tselect',
          tselect_ids_value: [person.city_id]
        }
      %>
    </div>
    <%= inline_error_for(:city_id, person, "offset-3") %>
  </div>
  
  <div class="form-group row mb-2">
    <%= form.label :images, "Imagen" %>
    <%= form.file_field :images %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :psicometrics, "Psicometrico" %>
    <%= form.file_field :psicometrics %>
  </div>

  <div class='mt-2'>
    <%= form.submit 'Guardar' %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
