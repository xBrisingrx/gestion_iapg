<h1>Certificados</h1>
<div data-controller="forms--certificates">
  <%= form_with(url: "#", method: :get, builder: BootstrapBuilder) do |form| %>
    <div class="form-group row mb-2">
      <%= form.label :course_type_id, "Tipo de curso" %>
      <div class="col-6">
        <%= form.select :course_type_id, CourseType.actives.collect { |course| [ "#{course.name}", course.id ] },
          {:include_blank => "Seleccione tipo de curso"},
          data: { controller: 'tselect',
            forms__certificates_target: "courseType",
            action: "forms--certificates#get_courses" }
        %>
      </div>
    </div>
    <div class="form-group row mb-2">
      <%= form.label :course_id, "Curso" %>
      <div class="col-8">
        <%= turbo_frame_tag :select_courses, data: { forms__certificates_target: "courses" } do %> 
          <%= form.select :course_id, {}, {include_blank: "Seleccione curso"}, class: "form-control form-control-sm" %>
        <% end %>
      </div>
    </div>
    <div class="form-group row mb-2">
      <%= form.label :company_id, "Operadora" %>
      <div class="col-6">
        <%= form.select :company_id, Company.where(operator: true).actives.collect { |course| [ "#{course.name}", course.id ] },
          {:include_blank => "Seleccione operadora"},
          data: { controller: 'tselect',
            forms__certificates_target: "company",
            action: "forms--certificates#get_people_in_course" }
        %>
      </div>
    </div>
  <% end %>


  <%= turbo_frame_tag 'people_in_course', id: 'people_in_course', data: { forms__certificates_target: "peopleInCourse" } do %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="thead-light">
          <tr>
            <th>Nombre</th>
            <th>Cuil</th>
            <th>Facturado</th>
            <th>Num certificado</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

