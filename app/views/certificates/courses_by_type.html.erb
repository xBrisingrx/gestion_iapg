<%= turbo_frame_tag :select_courses do %>
  <select name="course[id]" id="course_id" data-controller="tselect" data-forms--certificates-target="course">
    <option value="">Seleccione curso</option>
    <% @courses.each do |course|%>
      <option value="<%= course.id %>"><%= date_format(course.from_date) %> Sala: <%= course.room.name %> Sede: <%= course.room.headquarter.name %></option>
    <% end %>
  </select>
<% end %>