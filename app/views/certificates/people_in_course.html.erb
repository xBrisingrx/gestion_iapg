<%= turbo_frame_tag "people_in_course", id: "people_in_course" do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th><%= sort_link(@query, :name, "Nombre") %></th>
          <th><%= sort_link(@query, :cuil, "Cuil") %></th>
          <th>Facturado</th>
          <th>Num certificado</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @course_people.each do |course_person| %>
          <tr>
            <td><%= course_person.person.fullname %></td>
            <td><%= course_person.person.cuil %></td>
            <td> $$$ </td>
            <td> ## </td>
            <td> [estados] </td>
            <td>
              <%= link_to certificates_generate_certificate_path(course_person_id: course_person.id), 
                class: "btn btn-primary btn-sm btn-sm btn-icon text-white",
                title: 'Generar certificado', 
                target: "_blank" do %>
                <i class="bi bi-brush"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 6}) if @course_people.empty?%>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>