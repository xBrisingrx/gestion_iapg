<%= render "shared/modal", title: "Dar de baja pregunta", fade_in: true do %>
  <p>Se va a dar de baja la pregunta <b><%= @question.question %></b></p>
  <%= form_with(url: disable_question_path(@question), method: 'PUT') do |form| %>
      <%= form.submit 'Dar de baja', class: 'btn btn-danger' %>
      <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancelar</button>
    </div>
  <% end %>
<% end %>