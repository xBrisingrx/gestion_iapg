<%= form_with(model: question, builder: BootstrapBuilder) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :question, "Pregunta"%>
    <%= form.text_field :question, required: true %>
    <%= inline_error_for(:question, question, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :image, "Imágen"%>
    <%= form.file_field :image, required: true %>
    <%= inline_error_for(:image, question, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <div class="form-check">
      <%= form.check_box :eliminating,
        class: "form-check-input" %>
      <%= form.label :eliminating, "Es eliminatoria?" %>
    </div>
  </div>

  <div class="mt-2">
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>