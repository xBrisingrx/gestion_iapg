<%= tag.tr id: dom_id(question) do %>
  <td><%= question.question %></td>
  <td><%= question.eliminating %></td>
  <td> 
    <% if question.image.attached? %>
      <%= image_tag question.image.variant(:thumb) %>
    <% end %>
  </td>
  <td>
    <% if policy(question).edit? %>
      <%= link_to edit_question_path(question), 
        class: "btn btn-warning btn-sm btn-sm btn-icon text-white",title: "Editar" ,data: { turbo_frame: "modal"} do %>
        <i class="bi bi-pencil-square"></i>
      <% end %>
    <% end %>
    <% if policy(question).disable? %>
      <%= link_to modal_disable_question_path(question), 
        class: "btn btn-sm btn-icon btn-danger",title: "Eliminar", data: { turbo_frame: "modal"} do %>
        <i class="bi bi-trash"></i>
      <% end %>
    <% end %>
  </td>
<% end %>