<h1>Preguntas</h1>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "E-learning", elearning_exams_path %></li>
    <li class="breadcrumb-item"><%= link_to "Exámenes", exams_path %></li>
    <li class="breadcrumb-item active" aria-current="page">Preguntas</li>
    <li class="breadcrumb-item"><a href="#">Encuestas</a></li>
    <li class="breadcrumb-item"><%= link_to "Videos", videos_path %></li>
  </ol>
</nav>
<div class="row justify-content-between mb-2">
  <div class="col-4">
    <% if policy(@questions).new? %>
      <%= link_to "Registrar pregunta", 
        new_question_path,
        data: { turbo_frame: "modal"},
        class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
  <%= render "shared/filter_form", url_path: questions_path %>
</div>
<%= turbo_frame_tag 'table', id: 'questions_table' do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Nombre</th>
          <th>Es eliminatoria</th>
          <th>Imágen</th>
          <th>Respuestas</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_questions'>
        <%= render @questions %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 5}) if @questions.empty?%>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>