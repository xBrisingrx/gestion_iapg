<%= render "shared/modal", title: "Registrar pago", fade_in: true do %>
  <%= form_with(model: @invoice, builder: BootstrapBuilder) do |form| %>
    <div class="form-group row mb-2">
      <%= form.label :status, "Pago" %>
      <div class="col-6">
        <%= form.select :status, ["Pagado", "Pagado a confirmar"].each { |pago| [ pago, pago ] },
          {:include_blank => "Seleccione estado de pago"},
          data: { controller: 'tselect',
            tselect_ids_value: [@invoice.status]
          }
        %>
      </div>
      <%= inline_error_for(:status, @invoice, "offset-3") %>
    </div>

    <div class="form-group row mb-2">
      <%= form.label :pay_date, "Fecha de pago"%>
      <%= form.date_field :pay_date, required: true, value: Date.today %>
      <%= inline_error_for(:pay_date, @invoice, "offset-3") %>
    </div>

    <table id="table_items" class="table table-hover">
      <thead class="thead-light">
      <tr>
        <th>Bonificar</th>
        <th>Curso</th>
        <th>Modulo</th>
        <th>Persona</th>
        <th>Importe</th>
      </tr>
      <tbody>
        
        <% @invoice.invoice_items.each_with_index do |invoice_item, index| %>
          <tr class="course_person">
            <input type="hidden" 
              id="invoice_invoice_items_attributes_<%= index %>_id" 
              name="invoice[invoice_items_attributes][<%= index %>][id]"
              value="<%= invoice_item.id %>" >
            <input type="hidden" 
                 id="course_person_price"
                 value="<%= ( invoice_item.course_person.is_free ) ? 0 : invoice_item.course_person.price %>" 
                 class="item_price">
            <input type="hidden"
                  class="invoice_item_set_free"
                  id="invoice_invoice_items_attributes_<%= index %>_set_free"
                  name="invoice[invoice_items_attributes][<%= index %>][set_free]" >
            <td>
              <div class="form-check mb-3">
                <input 
                  type="checkbox" 
                  id="invoice_item_bonus"
                  class="form-check-input bonus"
                  data-controller="forms--invoice"
                  data-action="forms--invoice#set_is_free"
                  <%= invoice_item.course_person.is_free ? "Disabled" : "" %> >
                <label class="form-check-label" for="formCheck11"></label>
              </div>
            </td>
            <td><%= invoice_item.course_person.course.course_type.name %></td>
            <td><%= invoice_item.course_person.unit.name %></td>
            <td><%= invoice_item.course_person.person.fullname %></td>
            <td class="price">
              <% if invoice_item.course_person.is_free %>
                <span class='badge bg-info'>Bonificado</span>
              <% else %>
                <%= "$#{invoice_item.course_person.price}.00" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <tr>
          <td class="text-end" colspan="4"><b>Total:</b></td>
          <td id="total"><%= "$#{@invoice.total}.00" %></td>
        </tr>
      </tbody>
    </table>
    <div class="form-group row mb-2">
      <%= form.text_area :detail, placeholder: "Observacion" %>
      <%= inline_error_for(:detail, @invoice, "offset-3") %>
    </div>

    <div class='mt-2'>
      <%= form.submit 'Guardar' %>
      <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
  <% end %>
<% end %>