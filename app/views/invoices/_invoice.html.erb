<div id="<%= dom_id invoice %>">
  <p>
    <strong>Number:</strong>
    <%= invoice.number %>
  </p>

  <p>
    <strong>Company:</strong>
    <%= invoice.company_id %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= invoice.status %>
  </p>

  <p>
    <strong>Detail:</strong>
    <%= invoice.detail %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= invoice.date %>
  </p>

  <p>
    <strong>Pay date:</strong>
    <%= invoice.pay_date %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= invoice.active %>
  </p>

</div>
