<h1>Salas</h1>
<div class="row justify-content-between mb-2">
  <div class="col-4">
  </div>
</div>
<%= turbo_frame_tag 'table', id: 'invoices_table' do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>#</th>
          <th>Fecha</th>
          <th>Empresa</th>
          <th>Importe</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_invoices'>
        <%= render @invoices %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 5}) if @invoices.empty?%>
      </tbody>
    </table>
  </div>
<% end %>
