<%= form_with(model: invoice, builder: BootstrapBuilder, 
      data: { controller: "forms--invoice", 
        forms__invoice_target: "form",
        action: "forms--invoice#submit" }) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :date, "Fecha"%>
    <%= form.date_field :date, required: true, value: Date.today %>
    <%= inline_error_for(:date, invoice, "offset-3") %>
  </div>
  
  <div class="form-group row mb-2">
    <%= form.label :company_id, "Cliente" %>
    <div class="col-6">
      <%= form.select :company_id, Company.actives.collect { |company| [ "#{company.name}", company.id ] },
        {:include_blank => "Seleccione cliente"},
        data: {
          controller: "tselect",
          forms__invoice_target: "company",
          action: "forms--invoice#get_pendings",
          tselect_ids_value: [invoice.company_id]
        },
        required: true
      %>
    </div>
    <%= inline_error_for(:company_id, invoice, "offset-3") %>
  </div>

  <%= turbo_frame_tag "pendings", data: {forms__invoice_target: "items"} %>

  <div class="mt-2">
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
