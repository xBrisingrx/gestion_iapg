<%= render "shared/modal2", title: "Preguntas asignadas", fade_in: true do %>
  <%= turbo_frame_tag 'form' do %>
    <%= render(partial: "exam_questions/form", 
               locals: { 
                exam: @exam, 
                exam_question: ExamQuestion.new,
                questions: @questions
              }) %>
  <% end %>
  <%= turbo_frame_tag 'table', id: 'exam_questions_table' do %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="thead-light">
          <tr>
            <th>#</th>
            <th>Pregunta asignada</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id='tbody_exam_questions'>
          <%= render @exam_questions %>
          <%= render(partial: "shared/not_found_data", locals: {colspan: 3}) if @exam_questions.empty?%>
        </tbody>
      </table>
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %> 
<% end %>


