  <h3>Detalle de <%= @course_type.name %></h3>
  <section class="ms-2 border-bottom">
    <div class="mb-3">
      <h4>Descripción</h4>
      <p><%= @course_type.description %></p>
    </div>
    <div class="mb-3 row">
      <h4>Cupos</h4>
      <div class="col-6 col-md-4 col-lg-2">
        <label class="form-label">Mínimo</label>
        <p><%= @course_type.min_quota %></p>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <label class="form-label">Máximo</label>
        <p><%= @course_type.max_quota %></p>
      </div>
    </div>
    <div class="mb-3 row">
      <h4>Notas</h4>
      <div class="col-4 col-md-3 col-lg-2">
        <label class="form-label">Mínima</label>
        <p><%= @course_type.min_score %></p>
      </div>
      <div class="col-4 col-md-3 col-lg-2">
        <label class="form-label">Máxima</label>
        <p><%= @course_type.max_score %></p>
      </div>
      <div class="col-4 col-md-3 col-lg-2">
        <label class="form-label">Aprueba con</label>
        <p><%= @course_type.passing_score %></p>
      </div>
    </div>
    <div class="mb-3 row">
      <div class="col-6 col-md-4 col-lg-2">
        <h4>Recuperatorios</h4>
        <p><%= @course_type.number_of_repeat %></p>
      </div>
      <div class="col-6">
        <h4>Necesita código</h4>
        <p><%= @course_type.need_code ? "Si" : "No" %></p>
      </div>
    </div>
  </section>
  <table class="table table-hover table-striped mt-2">
    <thead class="thead-dark">
      <tr>
        <th>Modulo</th>
        <th>Dia</th>
        <th>Turno</th>
        <th>Horario</th>
        <th>Duración del turno</th>
        <th>Horarios de turnos</th>
      </tr>
    </thead>
    <tbody>
      <% @course_type_units.each do |unit| %>
        <tr>
          <td><%= unit.unit.name %></td>
          <td><%= unit.day %></td>
          <td><%= unit.shift %></td>
          <td><%= unit.schedule %></td>
          <td>
            <% if unit.is_by_turn %>
              <%= unit.shift_time %> minutos
            <% end %>
          </td>
          <td>
            <% if unit.is_by_turn %>
              <%= link_to course_hours_turns_path(course_type_unit: unit.id), 
                class: "btn btn-warning btn-sm btn-sm btn-icon text-white",title: 'Editar' ,data: { turbo_frame: "modal"} do %>
                <i class="bi bi-pencil-square"></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>