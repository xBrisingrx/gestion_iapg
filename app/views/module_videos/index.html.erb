<%= render "shared/modal", title: "Videos asignados", fade_in: true do %>
  <%= turbo_frame_tag "form" do %>
    <%= render(partial: "module_videos/form", 
               locals: {
                module_video: ModuleVideo.new,
                exam_module_id: @exam_module.id,
                videos: @videos
              }) %>
  <% end %>
  <%= turbo_frame_tag "table", id: "module_videos_table" do %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="thead-light">
          <tr>
            <th>#</th>
            <th>Video</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="tbody_module_videos">
          <%= render @module_videos %>
          <%= render(partial: "shared/not_found_data", locals: {colspan: 3}) if @module_videos.empty?%>
        </tbody>
      </table>
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %> 
<% end %>


