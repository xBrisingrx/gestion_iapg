<% content_for :title, "Precios" %>

<h1>Precios cursos</h1>

<div class="row justify-content-between mb-2">
  <div class="col-4">
    <% if policy(@prices).new? %>
      <%= link_to "Registrar precios", 
      new_price_course_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-primary" %>
    <% end%>
  </div>
  <%= render "shared/filter_form", url_path: price_courses_path %>
</div>
<small>Precios válidos desde <%= date_format(@start_date) %> hasta <%= date_format(@end_date) %></small>
<%= turbo_frame_tag 'table', id: 'prices_table' do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Curso</th>
          <th>Precio</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_prices'>
        <%= render @prices %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 3}) if @prices.empty?%>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
