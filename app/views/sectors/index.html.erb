<h1>Rubros de empresas</h1>
<div class="row justify-content-between mb-2">
  <div class="col-4">
    <% if policy(@sectors).new? %>
      <%= link_to "Registrar rubro", 
      new_sector_path,
      data: { turbo_frame: "modal"},
      class: "btn btn-sm btn-primary" %>
    <% end%>
  </div>
  <%= render "shared/filter_form", url_path: sectors_path %>
</div>
<%= turbo_frame_tag 'table', id: 'sectors_table' do %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id='tbody_sectors'>
        <%= render @sectors %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 3}) if @sectors.empty?%>
      </tbody>
    </table>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
