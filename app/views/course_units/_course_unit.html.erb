<div id="<%= dom_id course_unit %>">
  <p>
    <strong>Course:</strong>
    <%= course_unit.course_id %>
  </p>

  <p>
    <strong>Unit:</strong>
    <%= course_unit.unit_id %>
  </p>

  <p>
    <strong>Instructor:</strong>
    <%= course_unit.instructor_id %>
  </p>

  <p>
    <strong>Shift:</strong>
    <%= course_unit.shift %>
  </p>

  <p>
    <strong>Day:</strong>
    <%= course_unit.day %>
  </p>

  <p>
    <strong>Start hour:</strong>
    <%= course_unit.start_hour %>
  </p>

  <p>
    <strong>End hour:</strong>
    <%= course_unit.end_hour %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= course_unit.date %>
  </p>

  <p>
    <strong>Shift time:</strong>
    <%= course_unit.shift_time %>
  </p>

  <p>
    <strong>List:</strong>
    <%= course_unit.list %>
  </p>

</div>
