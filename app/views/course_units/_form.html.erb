<%= form_with(model: [ course, course_unit ], builder: BootstrapBuilder) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :unit_id, "Módulo" %>
    <div class="col-6">
      <%= form.select :unit_id, course.units.actives.collect { |unit| [ "#{unit.name}", unit.id ] },
        {:include_blank => "Seleccione módulo"},
        data: {controller: 'tselect',
          tselect_ids_value: @unit_id
        },
        required: true
      %>
    </div>
    <%= inline_error_for(:unit_id, course_unit, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :instructor_id, "Instructor" %>
    <div class="col-6">
      <%= form.select :instructor_id, Instructor.actives.collect { |instructor| [ "#{instructor.person.fullname}", instructor.id ] },
        {:include_blank => "Seleccione instructor"},
        data: {controller: 'tselect',
          tselect_ids_value: @instructor_id
        },
        required: true
      %>
    </div>
    <%= inline_error_for(:instructor_id, course_unit, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :shift, "Turno" %>
    <div class="col-6">
      <%= form.select :shift, [ "Mañana", "Tarde", "Completo" ].map { |shift| [ "#{shift}", shift ] },
        {:include_blank => "Seleccione turno"},
        class: "form-control",
        required: true
      %>
    </div>
    <%= inline_error_for(:shift, course_unit, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :start_hour, "Hora inicio" %>
    <%= form.time_field :start_hour %>
    <%= inline_error_for(:start_hour, course_unit, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :end_hour, "Hora fin" %>
    <%= form.time_field :end_hour %>
    <%= inline_error_for(:end_hour, course_unit, "offset-3") %>
  </div>

  <div class='mt-2'>
    <%= form.submit 'Guardar' %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
