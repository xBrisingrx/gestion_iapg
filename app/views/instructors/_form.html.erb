<%= form_with(model: instructor, builder: BootstrapBuilder) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :person_id, "Instructor" %>
    <div class="col-6">
      <%= form.select :person_id, Person.select(:id, :name, :last_name).actives.collect { |person| [ "#{person.fullname}", person.id ] },
        {:include_blank => "Seleccione instructor"},
        data: {controller: 'tselect',
          tselect_ids_value: [instructor.person_id]
        },
        required: true
      %>
    </div>
    <%= inline_error_for(:person_id, instructor, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :start_date, "Inicio actividad"%>
    <%= form.date_field :start_date %>
    <%= inline_error_for(:start_date, instructor, "offset-3") %>
  </div>

  <div class="form-check mb-2">
    <%= form.check_box :theoretical, class: "form-check-input" %>
    <%= form.label :theoretical, "Puede dar teoría" %>
  </div>

  <div class="form-check mb-2">
    <%= form.check_box :practical, class: "form-check-input" %>
    <%= form.label :practical, "Piede dar práctica" %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :code, "Código"%>
    <%= form.text_field :code %>
    <%= inline_error_for(:code, instructor, "offset-3") %>
  </div>

  <div class="mt-2">
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
