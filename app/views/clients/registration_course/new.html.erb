<%= render "shared/modal", title: "Registrar a curso", fade_in: true do %>
  <%= form_with( url: clients_register_to_course_path,  builder: BootstrapBuilder, 
    data: { controller: "forms--course-client forms--register-to-course", 
      forms__course_client_target: "form",
      action: "forms--course-client#register" } ) do |form| %>

    <div class="form-group row mb-2">
    <%= form.label :person_id, "CUIL" %>
    <%= form.number_field :cuil, data: {
      forms__course_client_target: "cuil",
      action: "forms--course-client#get_person_by_cuil"
    }, required: true %>
    <div class="offset-3 text-danger person_name"></div>
    <%= form.hidden_field :person_id, data: { forms__course_client_target: "personId" }, required: true %>
    <div class="col-6 offset-3 my-2">
      <input disabled=true class="form-control form-control-sm" data-forms--course-client-target="personName">
    </div>
  </div>
  
  <div class="form-group row mb-2">
    <%= form.label :operator_id, "Operadora" %>
    <div class="col-6">
      <%= form.select :operator_id, Company.actives.where(operator: true).collect { |company| [ "#{company.name}", company.id ] },
        {:include_blank => "Seleccione operadora"},
        data: {
          controller: 'tselect',
        },
        required: true
      %>
    </div>
  </div>
  <div class="form-group row mb-2">
    <%= form.label :fleet_category_id, "Flota" %>
    <div class="col-6">
      <%= form.select :fleet_category_id, FleetCategory.actives.collect { |fleet_category| [ fleet_category.name, fleet_category.id ] },
        {:include_blank => "Seleccione categoría de flota"},
        data: {controller: 'tselect',
        },
        required: true
      %>
    </div>
  </div>
  <div class="form-group row mb-2">
    <%= form.label :inscription_motive_id, "Motivo" %>
    <div class="col-6">
      <%= form.select :inscription_motive_id, InscriptionMotive.actives.collect { |motive| [ motive.name, motive.id ] },
        {:include_blank => "Seleccione motivo"},
        data: {
          controller: 'tselect',
        },
        required: true
      %>
    </div>
  </div>
    <div class="form-group row mb-2">
      <%= form.label "Selecciona flota y tipo de curso" %>
      <div class="col-4">
        <select name="course[type_fleet]" id="course_type_fleet"
          data-forms--register-to-course-target="filterCourses"
          data-action="change->forms--register-to-course#select_teoricos"
          class="form-control form-control-sm" required>
          <option value="">Seleccione ... </option>
          <option value="1" data-category="inicio" data-fleet="liviana" >Inicio liviano</option>
          <option value="2" data-category="inicio" data-fleet="pesada">Inicio pesado</option>
          <option value="3" data-category="renovacion" data-fleet="liviana">Renovación liviano</option>
          <option value="4" data-category="renovacion" data-fleet="pesada">Renovación pesado</option>
        </select>
      </div>
    </div>
    <input type="hidden" name="course[date_teorico]" id="course_date_teorico">
    <input type="hidden" name="course[date_psicometrico]" id="course_date_psicometrico">
    <input type="hidden" name="course[date_practico]" id="course_date_practico">
    <section class="mb-2">
      <%= turbo_frame_tag "courses", data: {forms__register_to_course_target: "selectTeorico"} %>
    </section>
    <section class="mb-2">
      <%= turbo_frame_tag "curso_practico", data: {forms__register_to_course_target: "selectPractico"} %>
    </section>
    <section class="mb-2">
      <%= turbo_frame_tag "curso_psicometrico", data: {forms__register_to_course_target: "selectPsicometrico"} %>
    </section>
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  <% end %>
<% end %>