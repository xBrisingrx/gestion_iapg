<%= form_with(model: [exam, exam_module], class: "mb-2", id: "form_new_exam_module") do |form| %>
  <div id="prevent-modal-close"></div>
  <div class="form-group row">
    <div class="col-8">
      <%= form.text_field :name, placeholder: "Módulo", class: "form-control form-control-sm" %>
    </div>
    <div class="col-2">
      <%= form.select :quote_type, options_for_select([["Liviano", "L"], ["Pesado", "P"]]),
        {:include_blank => "Tipo cupo"},
        required: true,
        class: "form-control form-control-sm"
      %>
    </div>
    <%= inline_error_for(:quote_type, exam_module, "offset-3") %>
    <div class="col-2">
      <%= form.submit "Guardar", class: "btn btn-primary btn-sm" %>
    </div>
  </div>
<% end %>
