<%= link_to "<", calendar_month_path(date: @date - 1.month) %>
<%= link_to "Hoy", calendar_month_path %>
<%= link_to ">", calendar_month_path(date: @date + 1.month) %>
<%= @date.strftime("%B %Y")%> <%= @courses.count %>
<div class="calendar-container">
  <% Date::ABBR_DAYNAMES.rotate.each do |weekday| %>
    <div>
      <%= weekday %>
    </div>
  <% end %>
  <% month_offset(@date).times do %>
    <div></div>
  <% end %>
  <% @date.all_month.each do |day| %>
    <div class="border <%= today_class(day) %>" style="min-height: 6rem">
      <%= yield day %>
    </div>
  <% end %>
</div>