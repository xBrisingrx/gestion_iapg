<div class="calendar-toolbar">
  <div class="calendar-toolbar__nav">
    <%= link_to "‹", calendar_month_path(date: @date - 1.month),
      class: "calendar-toolbar__btn", title: "Mes anterior" %>
    <%= link_to "Hoy", calendar_month_path,
      class: "calendar-toolbar__today" %>
    <%= link_to "›", calendar_month_path(date: @date + 1.month),
      class: "calendar-toolbar__btn", title: "Mes siguiente" %>
  </div>
  <h2 class="calendar-toolbar__title">
    <%= l(@date, format: "%B %Y").capitalize %>
  </h2>
</div>

<div class="calendar-grid">
  <% %w[Lun Mar Mié Jue Vie Sáb Dom].each do |weekday| %>
    <div class="calendar-weekday"><%= weekday %></div>
  <% end %>

  <% calendar_weeks(@date).each do |week| %>
    <% week.each do |day| %>
      <div class="<%= calendar_day_class(day, @date) %>">
        <span class="calendar-day__num"><%= day.day %></span>
        <%= yield day %>
      </div>
    <% end %>
  <% end %>
</div>
