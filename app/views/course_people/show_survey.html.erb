<%= render "shared/modal", title: "Encuesta", fade_in: true do %>
<small>Encuesta realizada por <%= @name %></small>
  <table class="table table-hover">
    <thead class="thead-light">
      <tr>
        <th>Pregunta</th>
        <th>Respuesta</th>
      </tr>
    </thead>
    <tbody>
      <% @surveys.each do |survey| %>
        <tr>
          <td><%= survey.question %></td>
          <td><%= survey.answer %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>