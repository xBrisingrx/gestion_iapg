<div id="<%= dom_id course_person %>">
  <p>
    <strong>Course:</strong>
    <%= course_person.course_id %>
  </p>

  <p>
    <strong>Person:</strong>
    <%= course_person.person_id %>
  </p>

  <p>
    <strong>Company:</strong>
    <%= course_person.company_id %>
  </p>

  <p>
    <strong>Inscription motive:</strong>
    <%= course_person.inscription_motive_id %>
  </p>

  <p>
