<%= tag.tr id: dom_id(course_person) do %>
  <td><%= course_person.person.last_name %></td>
  <td><%= course_person.person.name %></td>
  <td><%= course_person.person.cuil %></td>
  <td><%= course_person.company&.name %></td>
  <td><%= course_person.person.code %></td>
  <td><%= course_person.scoring_theoric %></td>
  <td>
    <%= link_to show_survey_path(id: course_person.id), 
      class: "btn btn-info btn-sm btn-sm btn-icon text-white",
      title: 'Editar',
      data: { turbo_frame: "modal"} do %>
      <i class="bi bi-pencil-square"></i>
    <% end %>
    <%= link_to modal_disable_course_course_person_path(course_id: course_person.course_id, id: course_person.id), 
        class: "btn btn-danger btn-sm btn-sm btn-icon text-white",
        title: "Eliminar", 
        data: { turbo_frame: "modal"} do %>
      <i class="bi bi-trash"></i>
    <% end %>
  </td>
  <%# <td>esto era por el covid</td> %>
<% end %>