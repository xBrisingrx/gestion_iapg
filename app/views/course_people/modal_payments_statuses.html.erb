<%= render "shared/modal", title: "Estado de pagos", fade_in: true do %>
  <table class="table table-hover">
    <thead class="thead-light">
      <tr>
        <th>Modulo</th>
        <th>Importe</th>
      </tr>
    </thead>
    <tbody id='tbody_course_people'>
      <% @course_people.each do |course_person| %>
        <tr>
          <td><%= course_person.unit.name %></td>
          <td><%= course_person.price %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>