<%= render "shared/modal", title: "Estado de pagos", fade_in: true do %>
  <table class="table table-hover">
    <thead class="thead-light">
      <tr>
        <th>Modulo</th>
        <th>Importe</th>
      </tr>
    </thead>
    <tbody id='tbody_course_people'>
      <% @course_people.each do |course_person| %>
        <tr>
          <td>
            <% if course_person.particular? %>
              <%= "#{course_person.unit.name} (Particular)" %>
            <% else %>
              <%= course_person.unit.name %>
            <% end %>
          </td>
          <td><%= "$#{course_person.price}.00" %></td>
        </tr>
      <% end %>
        <tr>
          <td class="text-end">Total:</td>
          <td><%= "$#{@total}" %></td>
        </tr>
    </tbody>
  </table>
<% end %>