<%= turbo_frame_tag "course_people" do %>
  <div>
    <%= link_to new_course_course_person_path(@course), 
      class: "btn btn-primary btn-sm btn-sm btn-icon text-white",
      title: 'Registrar cupo', 
      data: { turbo_frame: "modal"} do %>
      <i class="bi bi-person-add"></i>
    <% end %>
    
    <%= link_to register_attendance_course_path(@course), 
      class: "btn btn-info btn-sm btn-sm btn-icon text-white",
      title: 'Registrar cupo', 
      data: { turbo_frame: "modal"} do %>
      <i class="bi bi-person-add"></i>
    <% end %>
  </div>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Apellido</th>
          <th>Nombre</th>
          <th>CUIL</th>
          <th>Empresa</th>
          <th>Codigo</th>
          <th>Restado</th>
          <th>Declaracion</th>
        </tr>
      </thead>
      <tbody id='tbody_course_people'>
        <%= render @course_people %>
        <%= render(partial: "shared/not_found_data", locals: {colspan: 7}) if @course_people.empty?%>
      </tbody>
    </table>
    <%# pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>