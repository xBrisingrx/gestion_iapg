<%= turbo_frame_tag "pendings", data: {forms__invoice_target: "table_items"} do %>
  <table id="table_items" class="table table-hover">
    <thead class="thead-light">
      <tr>
        <th></th>
        <th>Bonificar</th>
        <th>Curso</th>
        <th>Modulo</th>
        <th>Persona</th>
        <th>Importe</th>
      </tr>
    </thead>
    <tbody id='tbody_course_people'>
      <% @course_people.each do |course_person| %>
        <tr class="course_person">
          <td>
            <div class="form-check mb-3">
              <input type="checkbox" id="add_item" class="form-check-input" data-action="forms--invoice#add_item" data-forms--invoice-target="add">
              <label class="form-check-label" for="formCheck11"></label>
            </div>
          </td>
          <td>
            <div class="form-check mb-3">
              <input 
                type="checkbox" 
                id="bonus" 
                class="form-check-input" 
                data-action="forms--invoice#set_bonus" 
                data-forms--invoice-target="bonus"
                <%= course_person.is_free ? "Disabled" : "" %>>
              <label class="form-check-label" for="formCheck11"></label>
            </div>
          </td>
          <td>
            <%= course_person.course.course_type.name %>
          </td>
          <td>
            <% if course_person.particular? %>
              <%= "#{course_person.unit.name} (Particular)" %>
            <% else %>
              <%= course_person.unit.name %>
            <% end %>
          </td>
          <td>
            <%= course_person.person.fullname %>
          </td>
          <td class="price">
            <% if course_person.is_free %>
              <span class='badge bg-info'>Bonificado</span>
            <% else %>
              <%= "$#{course_person.price}.00" %>
            <% end %>
          </td>
          <input type="hidden" 
                 id="course_person_price"
                 value="<%= ( course_person.is_free ) ? 0 : course_person.price %>" 
                 class="item_price">
          <input type="hidden" value="<%= course_person.id %>" id="course_person_id">
        </tr>
      <% end %>
        <tr>
          <td class="text-end" colspan="5"><b>Total:</b></td>
          <td id="total"></td>
        </tr>
    </tbody>
  </table>
<% end %>