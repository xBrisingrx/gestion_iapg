<%= render "shared/modal", title: "Quitar persona del curso", fade_in: true do %>
  <p>Se va a quitar del curso a  <b><%= @course_person.person.fullname %></b></p>
  <%= form_with(url: disable_course_course_person_path(course_id: @course_person.course_id, id: @course_person.id), method: 'PUT') do |form| %>
      <%= form.submit 'Dar de baja', class: 'btn btn-danger' %>
      <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancelar</button>
    </div>
  <% end %>
<% end %>