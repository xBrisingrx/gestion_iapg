<%= render "shared/modal", title: "Dar de baja examen", fade_in: true do %>
  <p>Se va a dar de baja el examen <b><%= @exam.title %></b></p>
  <%= form_with(url: disable_exam_path(@exam), method: 'PUT') do |form| %>
      <%= form.submit 'Dar de baja', class: 'btn btn-danger' %>
      <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancelar</button>
    </div>
  <% end %>
<% end %>