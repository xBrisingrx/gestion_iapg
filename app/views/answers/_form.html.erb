<%= form_with(model: [question, answer], id: "form_new_answer") do |form| %>
  <div id="prevent-modal-close"></div>
  <div class="row">
    <div class="col-8">
      <%= form.text_field :answer, class: "form-control form-control-sm", placeholder: "Respuesta" %>
    </div>
    <div class="col-2">
      <%= form.label :correct, "Es correcta"%>
      <%= form.checkbox :correct %>
    </div>
    <div class="col-2">
    <%= form.submit "Agregar", class: "btn btn-primary btn-sm" %>
    </div>
  </div>
<% end %>
