<%= render "shared/modal", title: "Respuestas", fade_in: true do %>
 <%= turbo_frame_tag 'form' do %>
    <%= render(partial: "answers/form", 
               locals: { 
                question: @question, 
                answer: Answer.new,
                submit_label: "Agregar" }) %>
  <% end %>
  <%= turbo_frame_tag 'table', id: 'answers_table' do %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="thead-light">
          <tr>
            <th>Respuesta</th>
            <th>Es correcta</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id='tbody_answers'>
          <%= render @answers %>
          <%= render(partial: "shared/not_found_data", locals: {colspan: 3}) if @answers.empty?%>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>