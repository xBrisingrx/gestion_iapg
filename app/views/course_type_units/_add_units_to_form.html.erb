<%= turbo_frame_tag :units do %>
  <div class="row col-12">
    <div class="col-2">
      <h3>Módulo</h3>
    </div>
    <div class="col-1">
      <h3>Turno</h3>
    </div>
    <div class="col-1">
      <h3>Cupos</h3>
    </div>
    <div class="col-2">
      <h3>Horario</h3>
    </div>
    <div class="col-2">
      <h3>Instructor</h3>
    </div>
  </div>
  <% course_type_units.each_with_index do |course_type_unit, index| %>
    <div class="form-group row mb-3">
      <div class="col-2">
        <label for=""> Día <%= course_type_unit.day %>: <%= course_type_unit.unit.name %> </label>
        <input type="hidden" 
          value=<%= course_type_unit.unit_id %> 
          name="course[course_units_attributes][<%= index %>][unit_id]">
        <input type="hidden" 
          value=<%= course_type_unit.day %> 
          name="course[course_units_attributes][<%= index %>][day]">
        <input type="hidden" 
          value=<%= course_type_unit.shift %> 
          name="course[course_units_attributes][<%= index %>][shift]">
        <input type="hidden" 
          value=<%= course_type_unit.shift_time %> 
          name="course[course_units_attributes][<%= index %>][shift_time]">
        <input type="hidden" 
          value=1 
          name="course[course_units_attributes][<%= index %>][list]">
      </div>
      <div class="col-1">
        <label for=""> <%= course_type_unit.shift %> </label>
      </div>
      <div class="col-1">
        <input type="number" disabled class="form-control" id="calc_quota" value=<%= course_type_unit.calc_quota %> />
      </div>
      <div class="col-4 row">
        <div class='col-6'>
          <input type="time" class="form-control start_hour" 
            value="<%= hour_format(course_type_unit.start_hour) %>"
            id="course_course_units_start_hour_<%= index %>"
            name="course[course_units_attributes][<%= index %>][start_hour]"
            data-courses--select-course-type-target="startHour"
            data-action="change->courses--select-course-type#calc_quota"
            data-shift-time="<%= course_type_unit.shift_time %>"
            data-index="<%= index %>"
            required />
            <div class="text-danger course_course_units_start_hour"></div>
        </div>
        <div class='col-6'>
          <input type="time" class="form-control end_hour" 
            value="<%= hour_format(course_type_unit.end_hour) %>"
            id="course_course_units_end_hour_<%= index %>"
            name="course[course_units_attributes][<%= index %>][end_hour]"
            data-action="change->forms--course#calc_quota"
            data-shift-time="<%= course_type_unit.shift_time %>"
            data-index="<%= index %>"
            required />
            <div class="text-danger course_course_units_end_hour"></div>
        </div>
      </div>
      <div class="col-2 row">
        <div class="col-10">
          <select id="course_course_units_<%= index %>" 
            name="course[course_units_attributes][<%= index %>][instructor_id]" 
            data-controller="tselect"
            data-action="change->forms--course#validate_instructor"
            class="form-control"
            required>
            <option value="">Seleccione instructor</option>
            <% instructors.each do |instructor| %>
              <option value="<%= instructor.id %>"><%= instructor.person.fullname %></option>
            <% end %>
          </select>
            <div class="text-danger course_course_units_instructor"></div>
        </div>
        <div class="col-2">
          <button type="button" 
            title="Qutar módulo" 
            data-action="forms--course#remove_unit" class="btn btn-danger btn-sm"> X 
          </button>
        </div>
      </div>
    </div>
  <% end %>
<% end %>