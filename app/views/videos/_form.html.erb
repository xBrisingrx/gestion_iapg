<%= form_with(model: video, builder: BootstrapBuilder) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :title, "Título"%>
    <%= form.text_field :title %>
    <%= inline_error_for(:title, video, "offset-3") %>
  </div>

  <div class="form-group row mb-2">
    <%= form.label :vimeo, "Link"%>
    <%= form.text_field :vimeo, placeholder: "http://vimeo.com/id_video" %>
    <%= inline_error_for(:vimeo, video, "offset-3") %>
  </div>

  <div class="mt-2">
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
