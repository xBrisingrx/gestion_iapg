<%= tag.tr id: dom_id(video) do %>
  <td><%= video.id %></td>
  <td><%= video.title %></td>
  <td><%= video.vimeo %></td>
  <td> Ver </td>
  <td>
    <% if policy(video).edit? %>
      <%= link_to edit_video_path(video), 
        class: "btn btn-warning btn-sm btn-sm btn-icon text-white",title: "Editar", data: { turbo_frame: "modal"} do %>
        <i class="bi bi-pencil-square"></i>
      <% end %>
    <% end %>
    <% if policy(video).disable? %>
      <%= link_to modal_disable_video_path(video), 
        class: "btn btn-danger btn-sm btn-icon",title: "Eliminar", data: { turbo_frame: "modal"} do %>
        <i class="bi bi-trash"></i>
      <% end %>
    <% end %>
  </td>
<% end %>